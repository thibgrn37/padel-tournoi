{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Padel Tournoi",
  "version": "0.1.0",
  "identifier": "fr.padeltournoi.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Padel Tournoi",
        "width": 1300,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5MkQ3OTRGQjlBNzNBQkEKUldTNk9xZTVUM2t0S2ZvRjlpV0ErSXgwS2c2bXplMG93WC9hc3llZk1QTmJrSnFSSVJiSkduV1gK",
      "endpoints": [
        "https://github.com/thibgrn37/padel-tournoi/releases/latest/download/latest.json"
      ]
    }
  }
}
